{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix web",
  "buildCommand": "mkdir -p web/public/data && cp results/*.json web/public/data/ && SITE_BASE=/ npm run build --prefix web",
  "outputDirectory": "web/dist",
  "redirects": [
    {
      "source": "/attention/:path*",
      "destination": "https://padraigobrien08.github.io/nanogpt-from-scratch/attention/",
      "permanent": false
    }
  ]
}
