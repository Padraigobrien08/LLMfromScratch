# Copy to .gpu.env (gitignored) and fill in from the RunPod console.
#
# RunPod shows the SSH command on the pod's Connect tab, in the form:
#   ssh root@194.26.196.XXX -p 22042 -i ~/.ssh/id_ed25519
# which maps onto GPU_USER@GPU_HOST -p GPU_PORT -i GPU_KEY below.
#
# No secret belongs in this file — authentication is by SSH key, referenced by path.

GPU_HOST=
GPU_PORT=22
GPU_USER=root
GPU_KEY=$HOME/.ssh/id_ed25519

# Hourly rate, used only to estimate spend in `gpu.sh status`. Set it to whatever
# the pod actually costs; a running job you have forgotten about is the single most
# expensive mistake available here.
GPU_RATE=3.29

# Must be a RunPod **network volume** mount. The container filesystem is destroyed
# with the pod, and re-tokenising 10B tokens is hours you would be paying for twice.
GPU_WORKDIR=/workspace

# The pod clones this, so results trace back to a commit someone else can check out.
GPU_REPO=https://github.com/Padraigobrien08/LLMfromScratch.git
GPU_BRANCH=main

# Seeds for the ablation baseline — the noise floor every reported delta is judged
# against. Below 3 the floor is not estimable and the report says so.
BASELINE_SEEDS=3

# Extra `--set key=value` overrides appended to the sweep / reproduction commands.
# e.g. SWEEP_EXTRA="--set data.micro_batch_size=32"
SWEEP_EXTRA=
REPRO_EXTRA=
